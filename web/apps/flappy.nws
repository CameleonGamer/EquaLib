{
  "name": "Flappy Bird NW",
  "description": "Jeu Flappy Bird pour NumWorks",
  "author": "Community GitHub",
  "version": "1.0",
  "created_at": "2026-10-01T16:21:13.071Z",
  "scripts": [
    {
      "name": "flappy.py",
      "text": "# Flappy Bird NumWorks\nimport kandinsky as kd\nimport ion\nimport time\n\ndef run():\n    kd.fill_rect(0, 0, 320, 240, kd.color(135, 206, 235))\n    kd.draw_string(\"Flappy Bird NumWorks\", 60, 40, kd.color(0, 0, 0))\n    kd.draw_string(\"Appuyez sur OK pour sauter\", 40, 100, kd.color(255, 255, 255), kd.color(0, 0, 0))\n    kd.draw_string(\"Appuyez sur Back pour quitter\", 35, 130, kd.color(255, 255, 255), kd.color(0, 0, 0))\n    \n    bird_y = 100\n    vel = 0\n    score = 0\n    \n    while True:\n        if ion.keydown(ion.KEY_BACK):\n            break\n        if ion.keydown(ion.KEY_OK):\n            vel = -6\n        \n        vel += 1\n        bird_y += vel\n        if bird_y < 10: bird_y = 10\n        if bird_y > 220: bird_y = 220\n        \n        kd.fill_rect(50, bird_y, 16, 16, kd.color(255, 200, 0))\n        time.sleep(0.04)\n\nrun()\n"
    }
  ]
}