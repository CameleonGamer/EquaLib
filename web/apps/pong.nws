{
  "name": "Pong Retro Arcade",
  "description": "Le classique Pong arcade 60 FPS contre IA avec physique fluide et dirty-rect",
  "author": "NW Arcade / EquaLib",
  "version": "2.2",
  "created_at": "2026-10-10T16:00:00.000Z",
  "scripts": [
    {
      "name": "pong.py",
      "text": "# Pong Retro Arcade - NumWorks Edition (60 FPS No-Flicker)\nimport kandinsky as kd\nimport ion\nimport time\nimport random\n\nC_BG = kd.color(8, 12, 22)\nC_WALL = kd.color(70, 85, 120)\nC_NET = kd.color(45, 60, 90)\nC_WHITE = kd.color(255, 255, 255)\nC_P1 = kd.color(0, 220, 255)\nC_CPU = kd.color(255, 75, 95)\n\nPW = 6\nPH = 40\nY_TOP = 26\nY_BOT = 236\nP1_X = 14\nCPU_X = 300\n\ndef draw_court():\n    kd.fill_rect(0, 0, 320, 240, C_BG)\n    kd.fill_rect(0, Y_TOP - 2, 320, 2, C_WALL)\n    kd.fill_rect(0, Y_BOT, 320, 2, C_WALL)\n    for y in range(Y_TOP + 4, Y_BOT - 4, 14):\n        kd.fill_rect(159, y, 2, 7, C_NET)\n\ndef draw_scores(s1, sc):\n    kd.fill_rect(60, 4, 200, 20, C_BG)\n    kd.draw_string(\"JOUEUR \" + str(s1), 60, 5, C_P1, C_BG)\n    kd.draw_string(\"CPU \" + str(sc), 210, 5, C_CPU, C_BG)\n\ndef redraw_net_at(y1, y2):\n    for y in range(Y_TOP + 4, Y_BOT - 4, 14):\n        if not (y + 7 < y1 or y > y2):\n            kd.fill_rect(159, y, 2, 7, C_NET)\n\ndef main():\n    try:\n        while True:\n            draw_court()\n            s1, sc = 0, 0\n            draw_scores(s1, sc)\n\n            p1_y = 110\n            cpu_y = 110\n            old_p1_y = p1_y\n            old_cpu_y = cpu_y\n\n            kd.fill_rect(P1_X, p1_y, PW, PH, C_P1)\n            kd.fill_rect(CPU_X, cpu_y, PW, PH, C_CPU)\n\n            match_over = False\n            target = 7\n\n            while not match_over:\n                bx, by = 160.0, 130.0\n                old_bx, old_by = int(bx), int(by)\n                bvx = 3.2 if random.random() < 0.5 else -3.2\n                bvy = (random.random() - 0.5) * 2.5\n                kd.fill_rect(old_bx, old_by, 6, 6, C_WHITE)\n                time.sleep(0.4)\n\n                point_active = True\n                while point_active:\n                    if ion.keydown(ion.KEY_BACK):\n                        return\n\n                    if (ion.keydown(ion.KEY_UP) or ion.keydown(ion.KEY_EIGHT)) and p1_y > Y_TOP + 2:\n                        p1_y -= 4\n                    elif (ion.keydown(ion.KEY_DOWN) or ion.keydown(ion.KEY_TWO)) and p1_y + PH < Y_BOT - 2:\n                        p1_y += 4\n\n                    if bvx > 0 and bx > 110:\n                        cpu_center = cpu_y + PH / 2\n                        target_y = by + 3 + (random.random() - 0.5) * 6\n                        if cpu_center < target_y - 4 and cpu_y + PH < Y_BOT - 2:\n                            cpu_y += 3\n                        elif cpu_center > target_y + 4 and cpu_y > Y_TOP + 2:\n                            cpu_y -= 3\n                    else:\n                        cpu_center = cpu_y + PH / 2\n                        if cpu_center < 125 and cpu_y + PH < Y_BOT - 2:\n                            cpu_y += 1\n                        elif cpu_center > 135 and cpu_y > Y_TOP + 2:\n                            cpu_y -= 1\n\n                    if p1_y != old_p1_y:\n                        if p1_y < old_p1_y:\n                            kd.fill_rect(P1_X, p1_y + PH, PW, old_p1_y - p1_y, C_BG)\n                            kd.fill_rect(P1_X, p1_y, PW, old_p1_y - p1_y, C_P1)\n                        else:\n                            kd.fill_rect(P1_X, old_p1_y, PW, p1_y - old_p1_y, C_BG)\n                            kd.fill_rect(P1_X, old_p1_y + PH, PW, p1_y - old_p1_y, C_P1)\n                        old_p1_y = p1_y\n\n                    if cpu_y != old_cpu_y:\n                        if cpu_y < old_cpu_y:\n                            kd.fill_rect(CPU_X, cpu_y + PH, PW, old_cpu_y - cpu_y, C_BG)\n                            kd.fill_rect(CPU_X, cpu_y, PW, old_cpu_y - cpu_y, C_CPU)\n                        else:\n                            kd.fill_rect(CPU_X, old_cpu_y, PW, cpu_y - old_cpu_y, C_BG)\n                            kd.fill_rect(CPU_X, old_cpu_y + PH, PW, cpu_y - old_cpu_y, C_CPU)\n                        old_cpu_y = cpu_y\n\n                    kd.fill_rect(old_bx, old_by, 6, 6, C_BG)\n                    if 155 <= old_bx <= 164:\n                        redraw_net_at(old_by, old_by + 6)\n                    if old_bx <= P1_X + PW:\n                        kd.fill_rect(P1_X, p1_y, PW, PH, C_P1)\n                    elif old_bx + 6 >= CPU_X:\n                        kd.fill_rect(CPU_X, cpu_y, PW, PH, C_CPU)\n\n                    nbx = bx + bvx\n                    nby = by + bvy\n\n                    if nby <= Y_TOP:\n                        nby = Y_TOP\n                        bvy = abs(bvy)\n                    elif nby + 6 >= Y_BOT:\n                        nby = Y_BOT - 6\n                        bvy = -abs(bvy)\n\n                    if bvx < 0 and bx >= P1_X + PW and nbx <= P1_X + PW:\n                        if nby + 6 >= p1_y - 2 and nby <= p1_y + PH + 2:\n                            nbx = P1_X + PW\n                            offset = ((nby + 3) - (p1_y + PH / 2)) / (PH / 2)\n                            bvy = offset * 4.2\n                            bvx = min(6.5, abs(bvx) * 1.06)\n                            if abs(bvy) < 0.4:\n                                bvy = 0.8 if bvy >= 0 else -0.8\n\n                    elif bvx > 0 and bx + 6 <= CPU_X and nbx + 6 >= CPU_X:\n                        if nby + 6 >= cpu_y - 2 and nby <= cpu_y + PH + 2:\n                            nbx = CPU_X - 6\n                            offset = ((nby + 3) - (cpu_y + PH / 2)) / (PH / 2)\n                            bvy = offset * 4.2\n                            bvx = -min(6.5, abs(bvx) * 1.06)\n                            if abs(bvy) < 0.4:\n                                bvy = 0.8 if bvy >= 0 else -0.8\n\n                    bx, by = nbx, nby\n\n                    if bx < 2:\n                        sc += 1\n                        draw_scores(s1, sc)\n                        point_active = False\n                        if sc >= target:\n                            match_over = True\n                    elif bx > 312:\n                        s1 += 1\n                        draw_scores(s1, sc)\n                        point_active = False\n                        if s1 >= target:\n                            match_over = True\n\n                    old_bx, old_by = int(bx), int(by)\n                    kd.fill_rect(old_bx, old_by, 6, 6, C_WHITE)\n\n                    time.sleep(0.018)\n\n            won = (s1 >= target)\n            box_bg = kd.color(15, 45, 30) if won else kd.color(60, 20, 25)\n            text_col = kd.color(50, 240, 120) if won else kd.color(255, 90, 90)\n            kd.fill_rect(45, 90, 230, 60, box_bg)\n            kd.fill_rect(47, 92, 226, 56, kd.color(12, 16, 28))\n            msg = \"VICTOIRE !\" if won else \"DEFAITE !\"\n            kd.draw_string(msg, 115, 98, text_col, kd.color(12, 16, 28))\n            kd.draw_string(str(s1) + \" - \" + str(sc), 140, 114, C_WHITE, kd.color(12, 16, 28))\n            kd.draw_string(\"OK: Rejouer | Back: Quitter\", 48, 132, kd.color(200, 215, 235), kd.color(12, 16, 28))\n\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n            while not ion.keydown(ion.KEY_OK):\n                if ion.keydown(ion.KEY_BACK):\n                    return\n                time.sleep(0.03)\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n    except KeyboardInterrupt:\n        pass\n\nmain()\n"
    }
  ]
}