{
  "name": "Casse-Briques (Breakout)",
  "description": "35 briques colorées avec biseau 3D, rebonds physiques angulaires et dirty-rect",
  "author": "Atari / EquaLib NW",
  "version": "2.2",
  "created_at": "2026-10-10T16:00:00.000Z",
  "scripts": [
    {
      "name": "breakout.py",
      "text": "# Casse-Briques (Breakout) - NumWorks Edition (60 FPS Physics & Bevels)\nimport kandinsky as kd\nimport ion\nimport time\nimport math\nimport random\n\nC_BG = kd.color(10, 12, 22)\nC_WALL = kd.color(60, 75, 110)\nC_WHITE = kd.color(255, 255, 255)\nC_PADDLE = kd.color(240, 245, 255)\n\nCOLORS = [\n    (kd.color(240, 50, 60), kd.color(255, 120, 130), kd.color(160, 20, 30)),\n    (kd.color(250, 130, 20), kd.color(255, 180, 80), kd.color(180, 80, 10)),\n    (kd.color(250, 210, 30), kd.color(255, 235, 110), kd.color(180, 140, 15)),\n    (kd.color(40, 200, 100), kd.color(110, 240, 160), kd.color(20, 130, 60)),\n    (kd.color(30, 180, 240), kd.color(110, 220, 255), kd.color(15, 110, 160))\n]\nPOINTS = [50, 40, 30, 20, 10]\n\nBW = 38\nBH = 10\nGAP_X = 4\nGAP_Y = 4\nGRID_X = 15\nGRID_Y = 36\nPW = 46\nPH = 7\nPY = 222\n\ndef draw_brick(r, c):\n    x = GRID_X + c * (BW + GAP_X)\n    y = GRID_Y + r * (BH + GAP_Y)\n    base, hi, sh = COLORS[r]\n    kd.fill_rect(x, y, BW, BH, base)\n    kd.fill_rect(x, y, BW, 1, hi)\n    kd.fill_rect(x, y, 1, BH, hi)\n    kd.fill_rect(x, y + BH - 1, BW, 1, sh)\n    kd.fill_rect(x + BW - 1, y, 1, BH, sh)\n\ndef erase_brick(r, c):\n    x = GRID_X + c * (BW + GAP_X)\n    y = GRID_Y + r * (BH + GAP_Y)\n    kd.fill_rect(x, y, BW, BH, C_BG)\n\ndef draw_hud(score, lives, force=False):\n    if force:\n        kd.fill_rect(0, 0, 320, 28, C_BG)\n        kd.fill_rect(0, 26, 320, 2, C_WALL)\n        kd.draw_string(\"CASSE-BRIQUES\", 12, 6, kd.color(255, 200, 40), C_BG)\n    kd.fill_rect(170, 4, 145, 20, C_BG)\n    kd.draw_string(\"SC:\" + str(score) + \" V:\" + str(lives), 175, 6, C_WHITE, C_BG)\n\ndef main():\n    try:\n        while True:\n            kd.fill_rect(0, 0, 320, 240, C_BG)\n            kd.fill_rect(0, 26, 320, 2, C_WALL)\n\n            bricks = [[1] * 7 for _ in range(5)]\n            remaining = 35\n            for r in range(5):\n                for c in range(7):\n                    draw_brick(r, c)\n\n            score = 0\n            lives = 3\n            draw_hud(score, lives, force=True)\n\n            paddle_x = 137\n            old_px = paddle_x\n            kd.fill_rect(paddle_x, PY, PW, PH, C_PADDLE)\n\n            ball_x = paddle_x + PW / 2 - 3\n            ball_y = float(PY - 7)\n            old_bx, old_by = int(ball_x), int(ball_y)\n            bvx = 2.4\n            bvy = -3.2\n            attached = True\n\n            won = False\n            while lives > 0 and remaining > 0:\n                if ion.keydown(ion.KEY_BACK):\n                    return\n\n                if (ion.keydown(ion.KEY_LEFT) or ion.keydown(ion.KEY_FOUR)) and paddle_x > 6:\n                    paddle_x -= 5\n                elif (ion.keydown(ion.KEY_RIGHT) or ion.keydown(ion.KEY_SIX)) and paddle_x + PW < 314:\n                    paddle_x += 5\n\n                if paddle_x != old_px:\n                    if paddle_x < old_px:\n                        kd.fill_rect(paddle_x + PW, PY, old_px - paddle_x, PH, C_BG)\n                        kd.fill_rect(paddle_x, PY, old_px - paddle_x, PH, C_PADDLE)\n                    else:\n                        kd.fill_rect(old_px, PY, paddle_x - old_px, PH, C_BG)\n                        kd.fill_rect(old_px + PW, PY, paddle_x - old_px, PH, C_PADDLE)\n                    old_px = paddle_x\n\n                if attached:\n                    ball_x = paddle_x + PW / 2 - 3\n                    ball_y = float(PY - 7)\n                    if ion.keydown(ion.KEY_OK) or ion.keydown(ion.KEY_UP) or ion.keydown(ion.KEY_EXE):\n                        attached = False\n                        bvx = 2.4 if random.random() < 0.5 else -2.4\n                        bvy = -3.4\n                else:\n                    nbx = ball_x + bvx\n                    nby = ball_y + bvy\n\n                    if nbx <= 4:\n                        nbx = 4\n                        bvx = abs(bvx)\n                    elif nbx + 6 >= 316:\n                        nbx = 310\n                        bvx = -abs(bvx)\n\n                    if nby <= 28:\n                        nby = 28\n                        bvy = abs(bvy)\n\n                    if bvy > 0 and ball_y + 6 <= PY and nby + 6 >= PY:\n                        if nbx + 6 >= paddle_x and nbx <= paddle_x + PW:\n                            nby = float(PY - 6)\n                            rel = ((nbx + 3) - (paddle_x + PW / 2)) / (PW / 2)\n                            bvx = rel * 4.4\n                            speed = 4.2\n                            vert_sq = speed * speed - bvx * bvx\n                            bvy = -math.sqrt(max(4.0, vert_sq))\n\n                    col_idx = int((nbx + 3 - GRID_X) // (BW + GAP_X))\n                    row_idx = int((nby + 3 - GRID_Y) // (BH + GAP_Y))\n\n                    if 0 <= row_idx < 5 and 0 <= col_idx < 7:\n                        if bricks[row_idx][col_idx] == 1:\n                            bricks[row_idx][col_idx] = 0\n                            erase_brick(row_idx, col_idx)\n                            remaining -= 1\n                            score += POINTS[row_idx]\n                            draw_hud(score, lives)\n\n                            b_x = GRID_X + col_idx * (BW + GAP_X)\n                            b_y = GRID_Y + row_idx * (BH + GAP_Y)\n                            if ball_y + 6 <= b_y or ball_y >= b_y + BH:\n                                bvy = -bvy\n                            else:\n                                bvx = -bvx\n\n                    ball_x, ball_y = nbx, nby\n\n                    if ball_y > 234:\n                        lives -= 1\n                        draw_hud(score, lives)\n                        kd.fill_rect(old_bx, old_by, 6, 6, C_BG)\n                        attached = True\n                        ball_x = paddle_x + PW / 2 - 3\n                        ball_y = float(PY - 7)\n\n                kd.fill_rect(old_bx, old_by, 6, 6, C_BG)\n                if old_by + 6 >= PY and old_bx + 6 >= paddle_x and old_bx <= paddle_x + PW:\n                    kd.fill_rect(paddle_x, PY, PW, PH, C_PADDLE)\n                old_bx, old_by = int(ball_x), int(ball_y)\n                kd.fill_rect(old_bx, old_by, 6, 6, C_WHITE)\n\n                time.sleep(0.018)\n\n            won = (remaining == 0)\n            box_bg = kd.color(15, 50, 25) if won else kd.color(60, 18, 22)\n            text_col = kd.color(50, 240, 100) if won else kd.color(255, 80, 80)\n            kd.fill_rect(45, 95, 230, 60, box_bg)\n            kd.fill_rect(47, 97, 226, 56, kd.color(12, 14, 26))\n            msg = \"VICTOIRE !\" if won else \"GAME OVER !\"\n            kd.draw_string(msg, 110, 102, text_col, kd.color(12, 14, 26))\n            kd.draw_string(\"Score: \" + str(score), 125, 118, C_WHITE, kd.color(12, 14, 26))\n            kd.draw_string(\"OK: Rejouer | Back: Quitter\", 48, 136, kd.color(200, 215, 235), kd.color(12, 14, 26))\n\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n            while not ion.keydown(ion.KEY_OK):\n                if ion.keydown(ion.KEY_BACK):\n                    return\n                time.sleep(0.03)\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n    except KeyboardInterrupt:\n        pass\n\nmain()\n"
    }
  ]
}