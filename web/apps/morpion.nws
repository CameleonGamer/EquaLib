{
  "name": "Morpion (Tic-Tac-Toe)",
  "description": "Alignez 3 symboles identiques pour remporter la manche",
  "author": "NW Classic",
  "version": "1.0",
  "created_at": "2026-10-07T16:00:00.000Z",
  "scripts": [
    {
      "name": "morpion.py",
      "text": "# Morpion NumWorks\nimport kandinsky as kd\nimport ion\nimport time\n\nkd.fill_rect(0, 0, 320, 240, kd.color(245, 245, 250))\nkd.draw_string(\"MORPION\", 125, 10, kd.color(30, 30, 60), kd.color(245, 245, 250))\nkd.draw_string(\"Fleches: Case | OK: Valider\", 30, 35, kd.color(100, 100, 120), kd.color(245, 245, 250))\n\n# Lignes de la grille 3x3\nkd.fill_rect(130, 60, 4, 150, kd.color(50, 50, 70))\nkd.fill_rect(185, 60, 4, 150, kd.color(50, 50, 70))\nkd.fill_rect(75, 110, 170, 4, kd.color(50, 50, 70))\nkd.fill_rect(75, 160, 170, 4, kd.color(50, 50, 70))\n\ncur_x = 1\ncur_y = 1\nturn = 1\n\nwhile True:\n    if ion.keydown(ion.KEY_BACK):\n        break\n    \n    if ion.keydown(ion.KEY_UP) and cur_y > 0:\n        cur_y -= 1; time.sleep(0.15)\n    if ion.keydown(ion.KEY_DOWN) and cur_y < 2:\n        cur_y += 1; time.sleep(0.15)\n    if ion.keydown(ion.KEY_LEFT) and cur_x > 0:\n        cur_x -= 1; time.sleep(0.15)\n    if ion.keydown(ion.KEY_RIGHT) and cur_x < 2:\n        cur_x += 1; time.sleep(0.15)\n    \n    # Dessiner symbole au clic\n    if ion.keydown(ion.KEY_OK):\n        sym = \"X\" if turn == 1 else \"O\"\n        col = kd.color(220, 30, 30) if turn == 1 else kd.color(30, 100, 220)\n        px = 95 + cur_x * 55\n        py = 80 + cur_y * 50\n        kd.draw_string(sym, px, py, col, kd.color(245, 245, 250))\n        turn = 2 if turn == 1 else 1\n        time.sleep(0.2)\n    \n    time.sleep(0.04)\n"
    }
  ]
}
