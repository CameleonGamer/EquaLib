{
  "name": "Snake Classic",
  "description": "Le jeu du serpent retro authentique avec score et controles fluides",
  "author": "Zardam",
  "version": "1.2",
  "created_at": "2026-10-01T16:21:13.073Z",
  "scripts": [
    {
      "name": "snake.py",
      "text": "# Snake Classic NumWorks\nimport kandinsky as kd\nimport ion\nimport random\nimport time\n\nkd.fill_rect(0, 0, 320, 240, kd.color(20, 20, 20))\nkd.draw_string(\"Snake Classic NW\", 80, 20, kd.color(0, 255, 100), kd.color(20, 20, 20))\nkd.draw_string(\"Fleches: Jouer | Back: Hub\", 40, 110, kd.color(255, 255, 255), kd.color(20, 20, 20))\n\nx = 160\ny = 120\ndx = 6\ndy = 0\nfood_x = 80\nfood_y = 90\nscore = 0\n\nwhile True:\n    if ion.keydown(ion.KEY_BACK):\n        break\n    if ion.keydown(ion.KEY_UP):\n        dx = 0; dy = -6\n    if ion.keydown(ion.KEY_DOWN):\n        dx = 0; dy = 6\n    if ion.keydown(ion.KEY_LEFT):\n        dx = -6; dy = 0\n    if ion.keydown(ion.KEY_RIGHT):\n        dx = 6; dy = 0\n    \n    kd.fill_rect(x, y, 6, 6, kd.color(20, 20, 20))\n    x += dx\n    y += dy\n    if x < 10: x = 310\n    if x > 310: x = 10\n    if y < 30: y = 230\n    if y > 230: y = 30\n    \n    if abs(x - food_x) < 8 and abs(y - food_y) < 8:\n        score += 1\n        food_x = random.randint(20, 300)\n        food_y = random.randint(40, 220)\n        kd.draw_string(str(score), 10, 10, kd.color(255, 255, 255), kd.color(20, 20, 20))\n    \n    kd.fill_rect(x, y, 6, 6, kd.color(0, 255, 0))\n    kd.fill_rect(food_x, food_y, 6, 6, kd.color(255, 50, 50))\n    time.sleep(0.04)\n"
    }
  ]
}