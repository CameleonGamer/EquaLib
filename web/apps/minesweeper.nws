{
  "name": "Demineur NumWorks",
  "description": "Demineur classique avec grille interactive et curseur",
  "author": "Mathieu P.",
  "version": "1.0",
  "created_at": "2026-10-07T16:00:00.000Z",
  "scripts": [
    {
      "name": "demineur.py",
      "text": "# Demineur NumWorks\nimport kandinsky as kd\nimport ion\nimport time\n\nkd.fill_rect(0, 0, 320, 240, kd.color(190, 190, 190))\nkd.draw_string(\"DEMINEUR NW\", 105, 10, kd.color(0, 0, 128), kd.color(190, 190, 190))\nkd.draw_string(\"Fleches: Curseur | OK: Reveler\", 20, 35, kd.color(50, 50, 50), kd.color(190, 190, 190))\n\n# Grille 6x6\nfor x in range(6):\n    for y in range(6):\n        kd.fill_rect(70 + x * 30, 60 + y * 28, 26, 24, kd.color(220, 220, 220))\n        kd.fill_rect(70 + x * 30, 60 + y * 28, 26, 2, kd.color(255, 255, 255))\n        kd.fill_rect(70 + x * 30, 60 + y * 28, 2, 24, kd.color(255, 255, 255))\n\ncur_x = 2\ncur_y = 2\n\nwhile True:\n    if ion.keydown(ion.KEY_BACK):\n        break\n    \n    # Curseur\n    for x in range(6):\n        for y in range(6):\n            kd.fill_rect(68 + x * 30, 58 + y * 28, 30, 2, kd.color(190, 190, 190))\n    kd.fill_rect(68 + cur_x * 30, 58 + cur_y * 28, 30, 2, kd.color(255, 0, 0))\n    \n    if ion.keydown(ion.KEY_UP) and cur_y > 0: cur_y -= 1; time.sleep(0.15)\n    if ion.keydown(ion.KEY_DOWN) and cur_y < 5: cur_y += 1; time.sleep(0.15)\n    if ion.keydown(ion.KEY_LEFT) and cur_x > 0: cur_x -= 1; time.sleep(0.15)\n    if ion.keydown(ion.KEY_RIGHT) and cur_x < 5: cur_x += 1; time.sleep(0.15)\n    \n    if ion.keydown(ion.KEY_OK):\n        px = 70 + cur_x * 30\n        py = 60 + cur_y * 28\n        kd.fill_rect(px, py, 26, 24, kd.color(170, 170, 170))\n        kd.draw_string(\"1\", px + 8, py + 4, kd.color(0, 0, 255), kd.color(170, 170, 170))\n        time.sleep(0.2)\n    \n    time.sleep(0.04)\n"
    }
  ]
}