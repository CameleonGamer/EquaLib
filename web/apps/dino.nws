{
  "name": "Chrome Dino Runner",
  "description": "Le jeu mythique du T-Rex avec T-Rex accroupi, ptérodactyles, nuages et hitboxes précises",
  "author": "Google / EquaLib NW",
  "version": "2.2",
  "created_at": "2026-10-10T16:00:00.000Z",
  "scripts": [
    {
      "name": "dino.py",
      "text": "# Chrome Dino Runner - NumWorks Edition (60 FPS Pixel-Art)\nimport kandinsky as kd\nimport ion\nimport time\nimport random\n\nC_DAY_BG = kd.color(247, 247, 247)\nC_DAY_FG = kd.color(83, 83, 83)\nC_DAY_CLOUD = kd.color(210, 210, 210)\n\nGROUND_Y = 192\nDINO_X = 35\nDINO_W = 20\nDINO_H = 24\nSTAND_Y = GROUND_Y - DINO_H\n\ndef draw_t_rex(y, leg, duck, fg, bg):\n    if duck:\n        kd.fill_rect(DINO_X, y + 10, 26, 8, fg)\n        kd.fill_rect(DINO_X + 20, y + 6, 8, 8, fg)\n        kd.fill_rect(DINO_X + 22, y + 7, 2, 2, bg)\n        if leg == 0:\n            kd.fill_rect(DINO_X + 6, y + 18, 4, 3, fg)\n            kd.fill_rect(DINO_X + 16, y + 18, 4, 1, fg)\n        else:\n            kd.fill_rect(DINO_X + 6, y + 18, 4, 1, fg)\n            kd.fill_rect(DINO_X + 16, y + 18, 4, 3, fg)\n    else:\n        kd.fill_rect(DINO_X + 8, y, 12, 10, fg)\n        kd.fill_rect(DINO_X + 11, y + 2, 2, 2, bg)\n        kd.fill_rect(DINO_X + 14, y + 8, 6, 2, bg)\n        kd.fill_rect(DINO_X + 4, y + 8, 10, 10, fg)\n        kd.fill_rect(DINO_X, y + 10, 4, 4, fg)\n        kd.fill_rect(DINO_X + 13, y + 11, 4, 2, fg)\n        if y < STAND_Y:\n            kd.fill_rect(DINO_X + 6, y + 18, 3, 5, fg)\n            kd.fill_rect(DINO_X + 11, y + 18, 3, 5, fg)\n        elif leg == 0:\n            kd.fill_rect(DINO_X + 6, y + 18, 3, 6, fg)\n            kd.fill_rect(DINO_X + 11, y + 18, 3, 2, fg)\n        else:\n            kd.fill_rect(DINO_X + 6, y + 18, 3, 2, fg)\n            kd.fill_rect(DINO_X + 11, y + 18, 3, 6, fg)\n\ndef erase_t_rex(y, bg):\n    kd.fill_rect(DINO_X, y, 28, DINO_H, bg)\n\ndef draw_cloud(x, y, col):\n    kd.fill_rect(x + 6, y, 18, 5, col)\n    kd.fill_rect(x + 2, y + 3, 26, 5, col)\n    kd.fill_rect(x, y + 5, 30, 4, col)\n\ndef erase_cloud(x, y, bg):\n    kd.fill_rect(x, y, 32, 10, bg)\n\ndef draw_cactus(x, t, fg):\n    if t == 0:\n        kd.fill_rect(x + 3, GROUND_Y - 20, 4, 20, fg)\n        kd.fill_rect(x, GROUND_Y - 14, 3, 6, fg)\n        kd.fill_rect(x + 7, GROUND_Y - 16, 3, 6, fg)\n    elif t == 1:\n        kd.fill_rect(x + 5, GROUND_Y - 28, 4, 28, fg)\n        kd.fill_rect(x, GROUND_Y - 20, 5, 10, fg)\n        kd.fill_rect(x + 9, GROUND_Y - 22, 5, 10, fg)\n    else:\n        kd.fill_rect(x + 2, GROUND_Y - 20, 4, 20, fg)\n        kd.fill_rect(x + 10, GROUND_Y - 24, 4, 24, fg)\n        kd.fill_rect(x + 6, GROUND_Y - 14, 4, 6, fg)\n\ndef erase_cactus(x, t, bg, fg):\n    w = 12 if t == 0 else (16 if t == 1 else 20)\n    kd.fill_rect(x, GROUND_Y - 30, w + 4, 30, bg)\n    kd.fill_rect(x, GROUND_Y, w + 4, 2, fg)\n\ndef draw_ptero(x, y, f, fg):\n    kd.fill_rect(x + 4, y + 4, 12, 4, fg)\n    kd.fill_rect(x, y + 5, 4, 2, fg)\n    kd.fill_rect(x + 16, y + 6, 4, 2, fg)\n    if f == 0:\n        kd.fill_rect(x + 6, y, 4, 5, fg)\n    else:\n        kd.fill_rect(x + 6, y + 7, 4, 5, fg)\n\ndef erase_ptero(x, y, bg):\n    kd.fill_rect(x, y, 22, 14, bg)\n\ndef main():\n    try:\n        hi_score = 0\n        while True:\n            bg = C_DAY_BG\n            fg = C_DAY_FG\n            cloud_col = C_DAY_CLOUD\n\n            kd.fill_rect(0, 0, 320, 240, bg)\n            kd.fill_rect(0, GROUND_Y, 320, 2, fg)\n            kd.draw_string(\"T-REX RUNNER\", 12, 10, fg, bg)\n\n            dino_y = float(STAND_Y)\n            vel_y = 0.0\n            on_ground = True\n            duck = False\n\n            cacti = [[340, 0]]\n            ptero = None\n            clouds = [[180, 45], [300, 60]]\n\n            score = 0\n            speed = 4.4\n            leg_frame = 0\n            tick = 0\n            game_over = False\n\n            while not game_over:\n                if ion.keydown(ion.KEY_BACK):\n                    return\n\n                jump_pressed = ion.keydown(ion.KEY_OK) or ion.keydown(ion.KEY_UP) or ion.keydown(ion.KEY_EIGHT)\n                duck = ion.keydown(ion.KEY_DOWN) or ion.keydown(ion.KEY_TWO)\n\n                if jump_pressed and on_ground:\n                    vel_y = -9.0\n                    on_ground = False\n\n                old_dy = int(dino_y)\n                if not on_ground:\n                    vel_y += 0.72\n                    if duck:\n                        vel_y += 0.4\n                    dino_y += vel_y\n                    if dino_y >= STAND_Y:\n                        dino_y = float(STAND_Y)\n                        vel_y = 0.0\n                        on_ground = True\n\n                tick += 1\n                if tick % 5 == 0:\n                    leg_frame = 1 - leg_frame\n\n                erase_t_rex(old_dy, bg)\n                draw_t_rex(int(dino_y), leg_frame, duck and on_ground, fg, bg)\n\n                for cl in clouds:\n                    old_cx = cl[0]\n                    cl[0] -= 1\n                    if cl[0] < -35:\n                        erase_cloud(old_cx, cl[1], bg)\n                        cl[0] = 330\n                        cl[1] = random.randint(30, 80)\n                    else:\n                        erase_cloud(old_cx, cl[1], bg)\n                        draw_cloud(cl[0], cl[1], cloud_col)\n\n                new_cacti = []\n                for c in cacti:\n                    old_cx = c[0]\n                    c[0] -= int(speed)\n                    erase_cactus(old_cx, c[1], bg, fg)\n\n                    cw = 10 if c[1] == 0 else (14 if c[1] == 1 else 18)\n                    ch = 20 if c[1] == 0 else (28 if c[1] == 1 else 24)\n\n                    d_x = DINO_X + (2 if duck else 4)\n                    d_y = int(dino_y) + (10 if duck else 2)\n                    d_w = 22 if duck else 14\n                    d_h = 12 if duck else 20\n\n                    c_x = c[0]\n                    c_y = GROUND_Y - ch\n                    c_w = cw\n                    c_h = ch\n\n                    if (d_x < c_x + c_w and d_x + d_w > c_x and\n                        d_y < c_y + c_h and d_y + d_h > c_y):\n                        game_over = True\n\n                    if c[0] > -25:\n                        draw_cactus(c[0], c[1], fg)\n                        new_cacti.append(c)\n                    else:\n                        score += 10\n                        if score > hi_score:\n                            hi_score = score\n                        if speed < 8.5:\n                            speed += 0.07\n\n                cacti = new_cacti\n                if len(cacti) == 0 or cacti[-1][0] < 320 - random.randint(110, 190):\n                    cacti.append([320, random.randint(0, 2)])\n\n                if score >= 250:\n                    if ptero is None and random.random() < 0.015 and len(cacti) > 0 and cacti[-1][0] < 220:\n                        ptero = [330, random.choice([GROUND_Y - 36, GROUND_Y - 22])]\n                    elif ptero is not None:\n                        old_px = ptero[0]\n                        ptero[0] -= int(speed + 1)\n                        erase_ptero(old_px, ptero[1], bg)\n                        if ptero[0] < -25:\n                            ptero = None\n                        else:\n                            draw_ptero(ptero[0], ptero[1], (tick // 6) % 2, fg)\n                            d_x = DINO_X + (2 if duck else 4)\n                            d_y = int(dino_y) + (10 if duck else 2)\n                            d_w = 22 if duck else 14\n                            d_h = 12 if duck else 20\n                            if (d_x < ptero[0] + 20 and d_x + d_w > ptero[0] and\n                                d_y < ptero[1] + 12 and d_y + d_h > ptero[1]):\n                                game_over = True\n\n                if tick % 2 == 0:\n                    kd.fill_rect(0, GROUND_Y, 320, 2, fg)\n                    kd.fill_rect((tick * 4) % 320, GROUND_Y + 4, 3, 1, fg)\n                    kd.fill_rect((tick * 4 + 140) % 320, GROUND_Y + 7, 2, 1, fg)\n\n                sc_str = \"HI \" + str(hi_score).zfill(5) + \"  \" + str(score).zfill(5)\n                kd.draw_string(sc_str, 155, 10, fg, bg)\n\n                time.sleep(0.018)\n\n            kd.fill_rect(45, 88, 230, 60, kd.color(220, 220, 220))\n            kd.fill_rect(47, 90, 226, 56, fg)\n            kd.draw_string(\"G A M E   O V E R\", 75, 96, bg, fg)\n            kd.draw_string(\"Score: \" + str(score), 120, 112, bg, fg)\n            kd.draw_string(\"OK: Rejouer | Back: Quitter\", 50, 130, bg, fg)\n\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n            while not ion.keydown(ion.KEY_OK):\n                if ion.keydown(ion.KEY_BACK):\n                    return\n                time.sleep(0.03)\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n    except KeyboardInterrupt:\n        pass\n\nmain()\n"
    }
  ]
}