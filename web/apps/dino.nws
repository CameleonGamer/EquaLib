{
  "name": "Chrome Dino Runner",
  "description": "Le celebre jeu du T-Rex sans connexion pour NumWorks",
  "author": "Google / NW Port",
  "version": "1.1",
  "created_at": "2026-10-07T16:00:00.000Z",
  "scripts": [
    {
      "name": "dino.py",
      "text": "# Chrome Dino Runner NumWorks\nimport kandinsky as kd\nimport ion\nimport time\n\nkd.fill_rect(0, 0, 320, 240, kd.color(247, 247, 247))\nkd.draw_string(\"CHROME DINO RUNNER\", 70, 30, kd.color(83, 83, 83), kd.color(247, 247, 247))\nkd.draw_string(\"OK ou Haut pour sauter | Back: Hub\", 15, 70, kd.color(120, 120, 120), kd.color(247, 247, 247))\nkd.fill_rect(0, 190, 320, 2, kd.color(83, 83, 83))\n\ndino_y = 160\nvel_y = 0\non_ground = True\ncactus_x = 300\nscore = 0\n\nwhile True:\n    if ion.keydown(ion.KEY_BACK):\n        break\n    if (ion.keydown(ion.KEY_OK) or ion.keydown(ion.KEY_UP)) and on_ground:\n        vel_y = -8\n        on_ground = False\n    \n    # Effacer ancien dino\n    kd.fill_rect(40, dino_y, 20, 30, kd.color(247, 247, 247))\n    \n    if not on_ground:\n        vel_y += 1\n        dino_y += vel_y\n        if dino_y >= 160:\n            dino_y = 160\n            vel_y = 0\n            on_ground = True\n    \n    # Dessiner dino\n    kd.fill_rect(40, dino_y, 20, 30, kd.color(83, 83, 83))\n    kd.fill_rect(48, dino_y + 4, 4, 4, kd.color(247, 247, 247))\n    \n    # Effacer ancien cactus\n    kd.fill_rect(cactus_x, 165, 12, 25, kd.color(247, 247, 247))\n    cactus_x -= 5\n    if cactus_x < -15:\n        cactus_x = 320\n        score += 1\n        kd.draw_string(str(score), 270, 20, kd.color(83, 83, 83), kd.color(247, 247, 247))\n    \n    # Dessiner cactus\n    kd.fill_rect(cactus_x, 165, 12, 25, kd.color(83, 83, 83))\n    \n    # Collision simple\n    if cactus_x >= 35 and cactus_x <= 55 and dino_y >= 140:\n        kd.draw_string(\"GAME OVER ! OK pour rejouer\", 30, 110, kd.color(200, 0, 0), kd.color(247, 247, 247))\n        while not ion.keydown(ion.KEY_OK) and not ion.keydown(ion.KEY_BACK):\n            time.sleep(0.05)\n        if ion.keydown(ion.KEY_BACK): break\n        cactus_x = 300\n        score = 0\n        kd.fill_rect(30, 110, 260, 20, kd.color(247, 247, 247))\n    \n    time.sleep(0.03)\n"
    }
  ]
}
