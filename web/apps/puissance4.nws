{
  "name": "Puissance 4",
  "description": "Alignez 4 jetons de meme couleur pour gagner",
  "author": "Milton Bradley / NW",
  "version": "1.0",
  "created_at": "2026-10-07T16:00:00.000Z",
  "scripts": [
    {
      "name": "puissance4.py",
      "text": "# Puissance 4 NumWorks\nimport kandinsky as kd\nimport ion\nimport time\n\nkd.fill_rect(0, 0, 320, 240, kd.color(20, 40, 80))\nkd.draw_string(\"PUISSANCE 4\", 105, 10, kd.color(255, 255, 255), kd.color(20, 40, 80))\nkd.draw_string(\"Gauche/Droite: Colonne | OK: Placer\", 10, 35, kd.color(180, 200, 240), kd.color(20, 40, 80))\n\n# Dessin de la grille 7x6\nfor col in range(7):\n    for row in range(6):\n        kd.fill_rect(45 + col * 34, 60 + row * 28, 26, 22, kd.color(240, 240, 240))\n\nsel_col = 3\nplayer = 1\n\nwhile True:\n    if ion.keydown(ion.KEY_BACK):\n        break\n    \n    # Curseur\n    for c in range(7):\n        kd.fill_rect(50 + c * 34, 48, 16, 6, kd.color(20, 40, 80))\n    kd.fill_rect(50 + sel_col * 34, 48, 16, 6, kd.color(255, 220, 0) if player == 1 else kd.color(255, 50, 50))\n    \n    if ion.keydown(ion.KEY_LEFT) and sel_col > 0:\n        sel_col -= 1\n        time.sleep(0.15)\n    if ion.keydown(ion.KEY_RIGHT) and sel_col < 6:\n        sel_col += 1\n        time.sleep(0.15)\n    \n    if ion.keydown(ion.KEY_OK):\n        color = kd.color(255, 220, 0) if player == 1 else kd.color(255, 50, 50)\n        # Remplir colonne\n        kd.fill_rect(45 + sel_col * 34, 60 + 5 * 28, 26, 22, color)\n        player = 2 if player == 1 else 1\n        time.sleep(0.2)\n    \n    time.sleep(0.04)\n"
    }
  ]
}
