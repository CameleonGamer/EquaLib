{
  "name": "Puissance 4",
  "description": "Plateau 7x6 avec gravité réelle, IA Minimax 2-ply tactique et détection de victoire",
  "author": "Milton Bradley / EquaLib",
  "version": "2.2",
  "created_at": "2026-10-10T16:00:00.000Z",
  "scripts": [
    {
      "name": "puissance4.py",
      "text": "# Puissance 4 - NumWorks Edition (60 FPS Minimax AI & Animated Drops)\nimport kandinsky as kd\nimport ion\nimport time\nimport random\n\nC_BG = kd.color(14, 22, 48)\nC_BOARD = kd.color(24, 72, 185)\nC_BOARD_HI = kd.color(50, 110, 240)\nC_SLOT = kd.color(10, 16, 36)\nC_YELLOW = kd.color(255, 215, 0)\nC_YELLOW_HI = kd.color(255, 245, 140)\nC_RED = kd.color(235, 45, 55)\nC_RED_HI = kd.color(255, 130, 140)\nC_WHITE = kd.color(255, 255, 255)\n\nSTART_X = 26\nSTART_Y = 54\nPITCH_X = 38\nPITCH_Y = 29\nSLOT_W = 30\nSLOT_H = 24\n\ndef draw_chip(r, c, val):\n    x = START_X + c * PITCH_X\n    y = START_Y + r * PITCH_Y\n    if val == 0:\n        kd.fill_rect(x, y, SLOT_W, SLOT_H, C_SLOT)\n        kd.fill_rect(x + 1, y, SLOT_W - 2, 1, kd.color(5, 8, 20))\n        kd.fill_rect(x, y + 1, 1, SLOT_H - 2, kd.color(5, 8, 20))\n    elif val == 1:\n        kd.fill_rect(x, y, SLOT_W, SLOT_H, C_YELLOW)\n        kd.fill_rect(x + 3, y + 2, 8, 4, C_YELLOW_HI)\n        kd.fill_rect(x, y + SLOT_H - 2, SLOT_W, 2, kd.color(200, 160, 0))\n    else:\n        kd.fill_rect(x, y, SLOT_W, SLOT_H, C_RED)\n        kd.fill_rect(x + 3, y + 2, 8, 4, C_RED_HI)\n        kd.fill_rect(x, y + SLOT_H - 2, SLOT_W, 2, kd.color(160, 20, 30))\n\ndef draw_cabinet():\n    kd.fill_rect(0, 0, 320, 240, C_BG)\n    kd.draw_string(\"PUISSANCE 4\", 105, 8, C_WHITE, C_BG)\n    kd.fill_rect(START_X - 6, START_Y - 4, 7 * PITCH_X + 8, 6 * PITCH_Y + 8, C_BOARD)\n    kd.fill_rect(START_X - 6, START_Y - 4, 7 * PITCH_X + 8, 2, C_BOARD_HI)\n    kd.fill_rect(START_X - 6, START_Y - 4, 2, 6 * PITCH_Y + 8, C_BOARD_HI)\n    for r in range(6):\n        for c in range(7):\n            draw_chip(r, c, 0)\n\ndef draw_cursor(sel_c, p, full=False):\n    kd.fill_rect(START_X - 6, 28, 7 * PITCH_X + 8, 22, C_BG)\n    x = START_X + sel_c * PITCH_X\n    col = kd.color(160, 40, 40) if full else (C_YELLOW if p == 1 else C_RED)\n    kd.fill_rect(x + 7, 30, 16, 10, col)\n    kd.fill_rect(x + 10, 40, 10, 5, col)\n    kd.fill_rect(x + 13, 45, 4, 3, col)\n    if full:\n        kd.draw_string(\"X\", x + 11, 29, C_WHITE, col)\n\ndef get_lowest_row(board, c):\n    for r in range(5, -1, -1):\n        if board[r][c] == 0:\n            return r\n    return -1\n\ndef check_win(board, p):\n    for r in range(6):\n        for c in range(4):\n            if board[r][c] == p and board[r][c+1] == p and board[r][c+2] == p and board[r][c+3] == p:\n                return [(r, c+i) for i in range(4)]\n    for r in range(3):\n        for c in range(7):\n            if board[r][c] == p and board[r+1][c] == p and board[r+2][c] == p and board[r+3][c] == p:\n                return [(r+i, c) for i in range(4)]\n    for r in range(3):\n        for c in range(4):\n            if board[r][c] == p and board[r+1][c+1] == p and board[r+2][c+2] == p and board[r+3][c+3] == p:\n                return [(r+i, c+i) for i in range(4)]\n    for r in range(3, 6):\n        for c in range(4):\n            if board[r][c] == p and board[r-1][c+1] == p and board[r-2][c+2] == p and board[r-3][c+3] == p:\n                return [(r-i, c+i) for i in range(4)]\n    return None\n\ndef score_position(board, p):\n    opp = 3 - p\n    score = 0\n    for r in range(6):\n        if board[r][3] == p:\n            score += 4\n        elif board[r][3] == opp:\n            score -= 4\n\n    def eval_window(w):\n        nonlocal score\n        p_cnt = w.count(p)\n        opp_cnt = w.count(opp)\n        e_cnt = w.count(0)\n        if p_cnt == 4:\n            score += 1000\n        elif p_cnt == 3 and e_cnt == 1:\n            score += 15\n        elif p_cnt == 2 and e_cnt == 2:\n            score += 4\n        if opp_cnt == 3 and e_cnt == 1:\n            score -= 80\n        elif opp_cnt == 2 and e_cnt == 2:\n            score -= 8\n\n    for r in range(6):\n        for c in range(4):\n            eval_window([board[r][c+i] for i in range(4)])\n    for r in range(3):\n        for c in range(7):\n            eval_window([board[r+i][c] for i in range(4)])\n    for r in range(3):\n        for c in range(4):\n            eval_window([board[r+i][c+i] for i in range(4)])\n    for r in range(3, 6):\n        for c in range(4):\n            eval_window([board[r-i][c+i] for i in range(4)])\n    return score\n\ndef ai_best_move(board):\n    for c in range(7):\n        r = get_lowest_row(board, c)\n        if r != -1:\n            board[r][c] = 2\n            if check_win(board, 2):\n                board[r][c] = 0\n                return c\n            board[r][c] = 0\n\n    for c in range(7):\n        r = get_lowest_row(board, c)\n        if r != -1:\n            board[r][c] = 1\n            if check_win(board, 1):\n                board[r][c] = 0\n                return c\n            board[r][c] = 0\n\n    best_c = 3\n    best_score = -99999\n    order = [3, 2, 4, 1, 5, 0, 6]\n    for c in order:\n        r = get_lowest_row(board, c)\n        if r != -1:\n            board[r][c] = 2\n            if r > 0:\n                board[r-1][c] = 1\n                if check_win(board, 1):\n                    board[r-1][c] = 0\n                    board[r][c] = 0\n                    continue\n                board[r-1][c] = 0\n\n            sc = score_position(board, 2)\n            board[r][c] = 0\n            if sc > best_score:\n                best_score = sc\n                best_c = c\n\n    return best_c\n\ndef drop_token_anim(board, c, target_r, p):\n    for r in range(target_r + 1):\n        draw_chip(r, c, p)\n        time.sleep(0.02)\n        if r < target_r:\n            draw_chip(r, c, 0)\n    board[target_r][c] = p\n\ndef main():\n    try:\n        while True:\n            draw_cabinet()\n            board = [[0] * 7 for _ in range(6)]\n            current_p = 1\n            sel_c = 3\n            draw_cursor(sel_c, current_p)\n\n            game_over = False\n            winner = 0\n            winning_cells = None\n\n            while not game_over:\n                if ion.keydown(ion.KEY_BACK):\n                    return\n\n                if current_p == 1:\n                    col_full = (board[0][sel_c] != 0)\n                    draw_cursor(sel_c, current_p, full=col_full)\n\n                    if (ion.keydown(ion.KEY_LEFT) or ion.keydown(ion.KEY_FOUR)) and sel_c > 0:\n                        sel_c -= 1\n                        draw_cursor(sel_c, current_p, full=(board[0][sel_c] != 0))\n                        time.sleep(0.12)\n                    elif (ion.keydown(ion.KEY_RIGHT) or ion.keydown(ion.KEY_SIX)) and sel_c < 6:\n                        sel_c += 1\n                        draw_cursor(sel_c, current_p, full=(board[0][sel_c] != 0))\n                        time.sleep(0.12)\n                    elif ion.keydown(ion.KEY_OK) or ion.keydown(ion.KEY_DOWN) or ion.keydown(ion.KEY_EXE):\n                        target_r = get_lowest_row(board, sel_c)\n                        if target_r != -1:\n                            drop_token_anim(board, sel_c, target_r, current_p)\n                            winning_cells = check_win(board, current_p)\n                            if winning_cells:\n                                winner = current_p\n                                game_over = True\n                                break\n                            if all(board[0][c] != 0 for c in range(7)):\n                                game_over = True\n                                break\n                            current_p = 2\n                            time.sleep(0.1)\n                else:\n                    draw_cursor(sel_c, current_p)\n                    time.sleep(0.25)\n                    ai_c = ai_best_move(board)\n                    sel_c = ai_c\n                    draw_cursor(sel_c, current_p)\n                    time.sleep(0.2)\n                    target_r = get_lowest_row(board, ai_c)\n                    if target_r != -1:\n                        drop_token_anim(board, ai_c, target_r, current_p)\n                        winning_cells = check_win(board, current_p)\n                        if winning_cells:\n                            winner = current_p\n                            game_over = True\n                            break\n                        if all(board[0][c] != 0 for c in range(7)):\n                            game_over = True\n                            break\n                        current_p = 1\n                        draw_cursor(sel_c, current_p)\n\n                time.sleep(0.02)\n\n            if winner != 0 and winning_cells:\n                for _ in range(4):\n                    for (r, c) in winning_cells:\n                        kd.fill_rect(START_X + c * PITCH_X, START_Y + r * PITCH_Y, SLOT_W, SLOT_H, C_WHITE)\n                    time.sleep(0.12)\n                    for (r, c) in winning_cells:\n                        draw_chip(r, c, winner)\n                    time.sleep(0.12)\n\n            box_bg = kd.color(15, 50, 25) if winner == 1 else (kd.color(60, 18, 22) if winner == 2 else kd.color(30, 40, 60))\n            kd.fill_rect(45, 92, 230, 60, box_bg)\n            kd.fill_rect(47, 94, 226, 56, kd.color(10, 14, 28))\n            msg = \"VOUS AVEZ GAGNE !\" if winner == 1 else (\"L'IA A GAGNE !\" if winner == 2 else \"MATCH NUL !\")\n            kd.draw_string(msg, 78, 100, C_WHITE, kd.color(10, 14, 28))\n            kd.draw_string(\"OK: Rejouer | Back: Quitter\", 48, 126, kd.color(200, 220, 245), kd.color(10, 14, 28))\n\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n            while not ion.keydown(ion.KEY_OK):\n                if ion.keydown(ion.KEY_BACK):\n                    return\n                time.sleep(0.03)\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n    except KeyboardInterrupt:\n        pass\n\nmain()\n"
    }
  ]
}