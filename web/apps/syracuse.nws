{
  "name": "Simulateur Suites & Collatz",
  "description": "Suite de Syracuse et temps de vol",
  "author": "MathLab",
  "version": "1.0",
  "created_at": "2026-10-01T16:21:13.078Z",
  "scripts": [
    {
      "name": "syracuse.py",
      "text": "# Suite de Syracuse\ndef syracuse(n):\n    vol = [n]\n    while n != 1:\n        n = n // 2 if n % 2 == 0 else 3 * n + 1\n        vol.append(n)\n    return vol\n\nprint(\"Test syracuse(27):\", len(syracuse(27)), \"etapes.\")\n"
    }
  ]
}