{
  "name": "Space Invaders Retro",
  "description": "Armada complète d'envahisseurs avec boucliers bunkers, ovni mystère et tirs continus",
  "author": "Tomohiro Nishikado / EquaLib",
  "version": "2.2",
  "created_at": "2026-10-10T16:00:00.000Z",
  "scripts": [
    {
      "name": "space_invaders.py",
      "text": "# Space Invaders Retro Arcade - NumWorks Edition (60 FPS Bunkers & Saucer)\nimport kandinsky as kd\nimport ion\nimport time\nimport random\n\nC_BG = kd.color(4, 6, 16)\nC_GREEN = kd.color(50, 230, 100)\nC_YELLOW = kd.color(255, 220, 30)\nC_CYAN = kd.color(40, 210, 255)\nC_RED = kd.color(255, 60, 60)\nC_WHITE = kd.color(255, 255, 255)\nC_SHIELD = kd.color(70, 210, 120)\n\nCAN_Y = 212\nCAN_W = 20\nCAN_H = 12\n\ndef draw_cannon(x):\n    kd.fill_rect(x + 8, CAN_Y, 4, 4, C_GREEN)\n    kd.fill_rect(x + 2, CAN_Y + 4, 16, 5, C_GREEN)\n    kd.fill_rect(x, CAN_Y + 9, 20, 3, C_GREEN)\n\ndef erase_cannon(x):\n    kd.fill_rect(x, CAN_Y, CAN_W, CAN_H, C_BG)\n\ndef draw_invader(x, y, row_type, frame):\n    col = C_YELLOW if row_type == 0 else (C_CYAN if row_type == 1 else C_RED)\n    if row_type == 0:\n        kd.fill_rect(x + 3, y, 6, 2, col)\n        kd.fill_rect(x + 1, y + 2, 10, 4, col)\n        kd.fill_rect(x + 3, y + 3, 2, 2, C_BG)\n        kd.fill_rect(x + 7, y + 3, 2, 2, C_BG)\n        if frame == 0:\n            kd.fill_rect(x, y + 6, 3, 4, col)\n            kd.fill_rect(x + 9, y + 6, 3, 4, col)\n        else:\n            kd.fill_rect(x + 2, y + 6, 3, 4, col)\n            kd.fill_rect(x + 7, y + 6, 3, 4, col)\n    elif row_type == 1:\n        kd.fill_rect(x + 2, y, 10, 2, col)\n        kd.fill_rect(x, y + 2, 14, 5, col)\n        kd.fill_rect(x + 3, y + 3, 2, 2, C_BG)\n        kd.fill_rect(x + 9, y + 3, 2, 2, C_BG)\n        if frame == 0:\n            kd.fill_rect(x, y + 7, 3, 3, col)\n            kd.fill_rect(x + 11, y + 7, 3, 3, col)\n        else:\n            kd.fill_rect(x + 3, y + 7, 3, 3, col)\n            kd.fill_rect(x + 8, y + 7, 3, 3, col)\n    else:\n        kd.fill_rect(x + 4, y, 6, 3, col)\n        kd.fill_rect(x + 1, y + 3, 12, 4, col)\n        kd.fill_rect(x + 3, y + 4, 2, 2, C_BG)\n        kd.fill_rect(x + 9, y + 4, 2, 2, C_BG)\n        if frame == 0:\n            kd.fill_rect(x + 1, y + 7, 3, 3, col)\n            kd.fill_rect(x + 6, y + 7, 2, 3, col)\n            kd.fill_rect(x + 10, y + 7, 3, 3, col)\n        else:\n            kd.fill_rect(x + 3, y + 7, 2, 3, col)\n            kd.fill_rect(x + 9, y + 7, 2, 3, col)\n\ndef erase_invader(x, y):\n    kd.fill_rect(x, y, 16, 11, C_BG)\n\ndef draw_ufo(x):\n    kd.fill_rect(x + 6, 26, 12, 3, C_RED)\n    kd.fill_rect(x + 2, 29, 20, 4, C_RED)\n    kd.fill_rect(x + 6, 30, 3, 2, C_YELLOW)\n    kd.fill_rect(x + 15, 30, 3, 2, C_YELLOW)\n    kd.fill_rect(x, 33, 24, 2, C_RED)\n\ndef erase_ufo(x):\n    kd.fill_rect(x, 26, 26, 10, C_BG)\n\ndef draw_bunker_block(bx, by, state):\n    col = C_SHIELD if state == 1 else C_BG\n    kd.fill_rect(bx, by, 7, 6, col)\n\ndef main():\n    try:\n        hi_score = 0\n        while True:\n            kd.fill_rect(0, 0, 320, 240, C_BG)\n            kd.draw_string(\"SPACE INVADERS\", 10, 6, C_GREEN, C_BG)\n            score = 0\n            lives = 3\n\n            can_x = 150\n            old_can_x = can_x\n            draw_cannon(can_x)\n\n            bunkers = []\n            for b_idx in range(3):\n                base_bx = 55 + b_idx * 95\n                bunkers.append([\n                    {'x': base_bx, 'y': 180, 'alive': True},\n                    {'x': base_bx + 9, 'y': 180, 'alive': True},\n                    {'x': base_bx - 3, 'y': 188, 'alive': True},\n                    {'x': base_bx + 12, 'y': 188, 'alive': True}\n                ])\n                for blk in bunkers[-1]:\n                    draw_bunker_block(blk['x'], blk['y'], 1)\n\n            aliens = []\n            for r in range(3):\n                for c in range(6):\n                    aliens.append({'r': r, 'c': c, 'alive': True})\n\n            form_x = 35.0\n            form_y = 42.0\n            form_dx = 3.0\n            anim_frame = 0\n            step_timer = 0\n            step_delay = 14\n\n            laser_x, laser_y = -1, -1\n            bomb_x, bomb_y = -1, -1\n            ufo_x = -100\n\n            def draw_hud():\n                kd.fill_rect(160, 6, 155, 18, C_BG)\n                kd.draw_string(\"SC:\" + str(score) + \" V:\" + str(lives), 165, 6, C_WHITE, C_BG)\n\n            draw_hud()\n\n            game_over = False\n            won = False\n\n            while not game_over and not won:\n                if ion.keydown(ion.KEY_BACK):\n                    return\n\n                if (ion.keydown(ion.KEY_LEFT) or ion.keydown(ion.KEY_FOUR)) and can_x > 8:\n                    can_x -= 4\n                elif (ion.keydown(ion.KEY_RIGHT) or ion.keydown(ion.KEY_SIX)) and can_x < 292:\n                    can_x += 4\n\n                if can_x != old_can_x:\n                    erase_cannon(old_can_x)\n                    draw_cannon(can_x)\n                    old_can_x = can_x\n\n                if (ion.keydown(ion.KEY_OK) or ion.keydown(ion.KEY_UP) or ion.keydown(ion.KEY_EXE)) and laser_y < 0:\n                    laser_x = can_x + 9\n                    laser_y = CAN_Y - 4\n\n                if laser_y >= 0:\n                    kd.fill_rect(laser_x, laser_y, 2, 7, C_BG)\n                    old_ly = laser_y\n                    laser_y -= 8\n                    if laser_y < 22:\n                        laser_y = -1\n                    else:\n                        kd.fill_rect(laser_x, laser_y, 2, 7, C_YELLOW)\n\n                        if ufo_x >= 0 and ufo_x <= laser_x <= ufo_x + 24 and 26 <= laser_y <= 36:\n                            erase_ufo(ufo_x)\n                            ufo_x = -100\n                            kd.fill_rect(laser_x, laser_y, 2, 7, C_BG)\n                            laser_y = -1\n                            score += 100\n                            draw_hud()\n\n                        if laser_y >= 0:\n                            for a in aliens:\n                                if a['alive']:\n                                    ax = int(form_x + a['c'] * 34)\n                                    ay = int(form_y + a['r'] * 18)\n                                    if ax - 2 <= laser_x <= ax + 16 and (ay <= old_ly and laser_y <= ay + 11):\n                                        a['alive'] = False\n                                        kd.fill_rect(laser_x, laser_y, 2, 7, C_BG)\n                                        laser_y = -1\n                                        erase_invader(ax, ay)\n                                        score += (30 if a['r'] == 0 else (20 if a['r'] == 1 else 10))\n                                        draw_hud()\n                                        break\n\n                        if laser_y >= 0:\n                            for b_grp in bunkers:\n                                for blk in b_grp:\n                                    if blk['alive'] and blk['x'] <= laser_x <= blk['x'] + 8 and blk['y'] <= laser_y <= blk['y'] + 7:\n                                        blk['alive'] = False\n                                        draw_bunker_block(blk['x'], blk['y'], 0)\n                                        kd.fill_rect(laser_x, laser_y, 2, 7, C_BG)\n                                        laser_y = -1\n                                        break\n\n                step_timer += 1\n                if step_timer >= step_delay:\n                    step_timer = 0\n                    anim_frame = 1 - anim_frame\n\n                    for a in aliens:\n                        if a['alive']:\n                            ax = int(form_x + a['c'] * 34)\n                            ay = int(form_y + a['r'] * 18)\n                            erase_invader(ax, ay)\n\n                    edge_hit = False\n                    for a in aliens:\n                        if a['alive']:\n                            ax = form_x + a['c'] * 34\n                            if (form_dx > 0 and ax >= 286) or (form_dx < 0 and ax <= 12):\n                                edge_hit = True\n                                break\n\n                    if edge_hit:\n                        form_dx = -form_dx\n                        form_y += 8\n                    else:\n                        form_x += form_dx\n\n                    alive_count = 0\n                    for a in aliens:\n                        if a['alive']:\n                            alive_count += 1\n                            ax = int(form_x + a['c'] * 34)\n                            ay = int(form_y + a['r'] * 18)\n                            draw_invader(ax, ay, a['r'], anim_frame)\n                            if ay + 10 >= CAN_Y - 4:\n                                game_over = True\n\n                    if alive_count == 0:\n                        won = True\n                        break\n\n                    step_delay = max(2, int(alive_count * 0.65) + 1)\n\n                    if bomb_y < 0 and random.random() < 0.45:\n                        alive_aliens = [a for a in aliens if a['alive']]\n                        if alive_aliens:\n                            shooter = random.choice(alive_aliens)\n                            bomb_x = int(form_x + shooter['c'] * 34 + 6)\n                            bomb_y = int(form_y + shooter['r'] * 18 + 11)\n\n                if bomb_y >= 0:\n                    kd.fill_rect(bomb_x, bomb_y, 3, 6, C_BG)\n                    bomb_y += 5\n                    hit_bunker = False\n                    for b_grp in bunkers:\n                        for blk in b_grp:\n                            if blk['alive'] and blk['x'] <= bomb_x <= blk['x'] + 8 and blk['y'] <= bomb_y <= blk['y'] + 7:\n                                blk['alive'] = False\n                                draw_bunker_block(blk['x'], blk['y'], 0)\n                                bomb_y = -1\n                                hit_bunker = True\n                                break\n                        if hit_bunker:\n                            break\n\n                    if not hit_bunker and bomb_y >= CAN_Y and bomb_y <= CAN_Y + CAN_H and bomb_x >= can_x - 1 and bomb_x <= can_x + CAN_W + 1:\n                        bomb_y = -1\n                        lives -= 1\n                        draw_hud()\n                        draw_cannon(can_x)\n                        if lives <= 0:\n                            game_over = True\n                    elif bomb_y > 230:\n                        bomb_y = -1\n                    elif bomb_y >= 0:\n                        kd.fill_rect(bomb_x, bomb_y, 3, 6, C_RED)\n\n                if ufo_x < 0 and random.random() < 0.006:\n                    ufo_x = 320\n                elif ufo_x >= -30:\n                    erase_ufo(ufo_x)\n                    ufo_x -= 3\n                    if ufo_x < -26:\n                        ufo_x = -100\n                    else:\n                        draw_ufo(ufo_x)\n\n                time.sleep(0.018)\n\n            box_bg = kd.color(15, 50, 25) if won else kd.color(60, 18, 22)\n            text_col = C_GREEN if won else C_RED\n            kd.fill_rect(45, 90, 230, 60, box_bg)\n            kd.fill_rect(47, 92, 226, 56, kd.color(8, 10, 20))\n            msg = \"VICTOIRE !\" if won else \"GAME OVER !\"\n            kd.draw_string(msg, 110, 98, text_col, kd.color(8, 10, 20))\n            kd.draw_string(\"Score: \" + str(score), 125, 114, C_WHITE, kd.color(8, 10, 20))\n            kd.draw_string(\"OK: Rejouer | Back: Quitter\", 48, 132, kd.color(200, 215, 235), kd.color(8, 10, 20))\n\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n            while not ion.keydown(ion.KEY_OK):\n                if ion.keydown(ion.KEY_BACK):\n                    return\n                time.sleep(0.03)\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n    except KeyboardInterrupt:\n        pass\n\nmain()\n"
    }
  ]
}