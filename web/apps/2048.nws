{
  "name": "2048 Ultimate",
  "description": "Le casse-tete 2048 authentique avec fusion fluide, records et animations 60 FPS",
  "author": "Gabriele Cirulli / EquaLib NW",
  "version": "2.2",
  "created_at": "2026-10-10T16:00:00.000Z",
  "scripts": [
    {
      "name": "g2048.py",
      "text": "# 2048 Ultimate - NumWorks Edition (60 FPS Dirty-Rect)\nimport kandinsky as kd\nimport ion\nimport time\nimport random\n\nC_BG = kd.color(250, 248, 239)\nC_GRID = kd.color(187, 173, 160)\nC_EMPTY = kd.color(205, 193, 180)\nC_DARK = kd.color(119, 110, 101)\nC_LIGHT = kd.color(255, 255, 255)\n\nTILES = {\n    0: (C_EMPTY, C_EMPTY),\n    2: (kd.color(238, 228, 218), C_DARK),\n    4: (kd.color(237, 224, 200), C_DARK),\n    8: (kd.color(242, 177, 121), C_LIGHT),\n    16: (kd.color(245, 149, 99), C_LIGHT),\n    32: (kd.color(246, 124, 95), C_LIGHT),\n    64: (kd.color(233, 89, 55), C_LIGHT),\n    128: (kd.color(237, 207, 114), C_LIGHT),\n    256: (kd.color(237, 204, 97), C_LIGHT),\n    512: (kd.color(237, 200, 80), C_LIGHT),\n    1024: (kd.color(237, 197, 63), C_LIGHT),\n    2048: (kd.color(237, 194, 46), C_LIGHT),\n    4096: (kd.color(158, 207, 102), C_LIGHT),\n    8192: (kd.color(92, 184, 92), C_LIGHT)\n}\n\nGX, GY = 59, 38\nCW, CH, GAP = 44, 43, 5\n\ndef draw_hud(score, best, force=False):\n    if force:\n        kd.fill_rect(0, 0, 320, 36, C_BG)\n        kd.draw_string(\"2048\", 16, 9, kd.color(143, 122, 102), C_BG)\n        kd.fill_rect(130, 6, 86, 24, C_GRID)\n        kd.fill_rect(224, 6, 86, 24, C_GRID)\n        kd.draw_string(\"SC\", 134, 10, kd.color(238, 228, 218), C_GRID)\n        kd.draw_string(\"HI\", 228, 10, kd.color(238, 228, 218), C_GRID)\n    kd.fill_rect(156, 6, 60, 24, C_GRID)\n    kd.draw_string(str(score), 158, 10, C_LIGHT, C_GRID)\n    kd.fill_rect(250, 6, 60, 24, C_GRID)\n    kd.draw_string(str(best), 252, 10, C_LIGHT, C_GRID)\n\ndef draw_cell(r, c, v):\n    x = GX + GAP + c * (CW + GAP)\n    y = GY + GAP + r * (CH + GAP)\n    bg, fg = TILES.get(v, (kd.color(60, 58, 50), C_LIGHT))\n    kd.fill_rect(x, y, CW, CH, bg)\n    if v > 0:\n        s = str(v)\n        tx = x + (CW - len(s) * 10) // 2\n        ty = y + (CH - 18) // 2\n        kd.draw_string(s, tx, ty, fg, bg)\n\ndef draw_board(grid):\n    kd.fill_rect(GX, GY, 4 * CW + 5 * GAP, 4 * CH + 5 * GAP, C_GRID)\n    for r in range(4):\n        for c in range(4):\n            draw_cell(r, c, grid[r][c])\n\ndef spawn(grid):\n    empty = [(r, c) for r in range(4) for c in range(4) if grid[r][c] == 0]\n    if empty:\n        r, c = random.choice(empty)\n        grid[r][c] = 4 if random.random() < 0.1 else 2\n        draw_cell(r, c, grid[r][c])\n        return True\n    return False\n\ndef slide_row(row):\n    compact = [x for x in row if x != 0]\n    res = []\n    sc = 0\n    i = 0\n    while i < len(compact):\n        if i + 1 < len(compact) and compact[i] == compact[i + 1]:\n            val = compact[i] * 2\n            res.append(val)\n            sc += val\n            i += 2\n        else:\n            res.append(compact[i])\n            i += 1\n    res += [0] * (4 - len(res))\n    return res, sc\n\ndef move(grid, direction):\n    new_g = [[0]*4 for _ in range(4)]\n    score_gain = 0\n    if direction == 0:\n        for r in range(4):\n            row, s = slide_row(grid[r])\n            new_g[r] = row\n            score_gain += s\n    elif direction == 1:\n        for r in range(4):\n            row, s = slide_row(grid[r][::-1])\n            new_g[r] = row[::-1]\n            score_gain += s\n    elif direction == 2:\n        for c in range(4):\n            col = [grid[r][c] for r in range(4)]\n            res, s = slide_row(col)\n            score_gain += s\n            for r in range(4):\n                new_g[r][c] = res[r]\n    elif direction == 3:\n        for c in range(4):\n            col = [grid[r][c] for r in range(4)][::-1]\n            res, s = slide_row(col)\n            score_gain += s\n            res = res[::-1]\n            for r in range(4):\n                new_g[r][c] = res[r]\n    return new_g, score_gain\n\ndef can_move(g):\n    for r in range(4):\n        for c in range(4):\n            if g[r][c] == 0:\n                return True\n            if c < 3 and g[r][c] == g[r][c + 1]:\n                return True\n            if r < 3 and g[r][c] == g[r + 1][c]:\n                return True\n    return False\n\ndef main():\n    try:\n        best = 0\n        while True:\n            kd.fill_rect(0, 0, 320, 240, C_BG)\n            grid = [[0]*4 for _ in range(4)]\n            score = 0\n            draw_hud(score, best, force=True)\n            draw_board(grid)\n            spawn(grid)\n            spawn(grid)\n\n            won_2048 = False\n            over = False\n\n            while not over:\n                if ion.keydown(ion.KEY_BACK):\n                    return\n\n                dir_move = -1\n                if ion.keydown(ion.KEY_LEFT) or ion.keydown(ion.KEY_FOUR):\n                    dir_move = 0\n                elif ion.keydown(ion.KEY_RIGHT) or ion.keydown(ion.KEY_SIX):\n                    dir_move = 1\n                elif ion.keydown(ion.KEY_UP) or ion.keydown(ion.KEY_EIGHT):\n                    dir_move = 2\n                elif ion.keydown(ion.KEY_DOWN) or ion.keydown(ion.KEY_TWO):\n                    dir_move = 3\n\n                if dir_move != -1:\n                    new_g, pts = move(grid, dir_move)\n                    if new_g != grid:\n                        old_g = [row[:] for row in grid]\n                        grid = new_g\n                        score += pts\n                        if score > best:\n                            best = score\n                        draw_hud(score, best)\n\n                        for r in range(4):\n                            for c in range(4):\n                                if grid[r][c] != old_g[r][c]:\n                                    draw_cell(r, c, grid[r][c])\n\n                        time.sleep(0.05)\n                        spawn(grid)\n\n                        if not won_2048 and any(2048 in row for row in grid):\n                            won_2048 = True\n                            kd.fill_rect(40, 10, 240, 22, kd.color(237, 194, 46))\n                            kd.draw_string(\"TUILE 2048 ATTEINTE !\", 55, 12, C_LIGHT, kd.color(237, 194, 46))\n                            time.sleep(0.8)\n                            draw_hud(score, best, force=True)\n\n                        if not can_move(grid):\n                            over = True\n\n                        debounce = 0\n                        while (ion.keydown(ion.KEY_LEFT) or ion.keydown(ion.KEY_RIGHT) or\n                               ion.keydown(ion.KEY_UP) or ion.keydown(ion.KEY_DOWN) or\n                               ion.keydown(ion.KEY_FOUR) or ion.keydown(ion.KEY_SIX) or\n                               ion.keydown(ion.KEY_EIGHT) or ion.keydown(ion.KEY_TWO)) and debounce < 20:\n                            if ion.keydown(ion.KEY_BACK):\n                                return\n                            time.sleep(0.02)\n                            debounce += 1\n\n                time.sleep(0.02)\n\n            kd.fill_rect(35, 90, 250, 60, kd.color(238, 228, 218))\n            kd.fill_rect(37, 92, 246, 56, kd.color(143, 122, 102))\n            kd.draw_string(\"GAME OVER !\", 108, 98, C_LIGHT, kd.color(143, 122, 102))\n            kd.draw_string(\"Score: \" + str(score), 115, 114, kd.color(237, 224, 200), kd.color(143, 122, 102))\n            kd.draw_string(\"OK: Rejouer | Back: Quitter\", 42, 132, kd.color(250, 248, 239), kd.color(143, 122, 102))\n\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n            while not ion.keydown(ion.KEY_OK):\n                if ion.keydown(ion.KEY_BACK):\n                    return\n                time.sleep(0.03)\n            while ion.keydown(ion.KEY_OK):\n                time.sleep(0.02)\n    except KeyboardInterrupt:\n        pass\n\nmain()\n"
    }
  ]
}