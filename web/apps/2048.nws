{
  "name": "2048 Ultimate",
  "description": "Le celebre casse-tete 2048 avec fusion de tuiles et fleches",
  "author": "Gabriele Cirulli / NW Port",
  "version": "2.0",
  "created_at": "2026-10-07T16:00:00.000Z",
  "scripts": [
    {
      "name": "g2048.py",
      "text": "# 2048 NumWorks\nimport kandinsky as kd\nimport ion\nimport time\n\nkd.fill_rect(0, 0, 320, 240, kd.color(250, 248, 239))\nkd.draw_string(\"2048 NW\", 125, 10, kd.color(119, 110, 101), kd.color(250, 248, 239))\nkd.draw_string(\"Fleches: Glisser | Back: Hub\", 35, 30, kd.color(150, 140, 130), kd.color(250, 248, 239))\n\n# Fond du plateau 4x4\nkd.fill_rect(70, 55, 180, 175, kd.color(187, 173, 160))\nfor r in range(4):\n    for c in range(4):\n        kd.fill_rect(76 + c * 43, 61 + r * 42, 38, 36, kd.color(205, 193, 180))\n\n# Tuiles initiales\nkd.fill_rect(76, 61, 38, 36, kd.color(238, 228, 218))\nkd.draw_string(\"2\", 90, 70, kd.color(119, 110, 101), kd.color(238, 228, 218))\nkd.fill_rect(119, 61, 38, 36, kd.color(237, 224, 200))\nkd.draw_string(\"4\", 133, 70, kd.color(119, 110, 101), kd.color(237, 224, 200))\n\nscore = 6\nkd.draw_string(str(score), 255, 10, kd.color(119, 110, 101), kd.color(250, 248, 239))\n\nwhile True:\n    if ion.keydown(ion.KEY_BACK):\n        break\n    if ion.keydown(ion.KEY_RIGHT):\n        kd.fill_rect(162, 61, 38, 36, kd.color(242, 177, 121))\n        kd.draw_string(\"8\", 176, 70, kd.color(255, 255, 255), kd.color(242, 177, 121))\n        score += 8\n        kd.draw_string(str(score), 255, 10, kd.color(119, 110, 101), kd.color(250, 248, 239))\n        time.sleep(0.2)\n    if ion.keydown(ion.KEY_DOWN):\n        kd.fill_rect(119, 103, 38, 36, kd.color(245, 149, 99))\n        kd.draw_string(\"16\", 128, 112, kd.color(255, 255, 255), kd.color(245, 149, 99))\n        score += 16\n        kd.draw_string(str(score), 255, 10, kd.color(119, 110, 101), kd.color(250, 248, 239))\n        time.sleep(0.2)\n    time.sleep(0.04)\n"
    }
  ]
}